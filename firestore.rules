rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common identifier format validation
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Schema Validation for Influencer entity
    function isValidInfluencer(data) {
      return data.keys().hasAll(['name', 'status'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.status is string && data.status.size() <= 100;
    }

    // Schema Validation for Cooperation Record entity
    function isValidRecord(data) {
      return data.keys().hasAll(['influencerId', 'brandName', 'projectName'])
        && data.influencerId is string && data.influencerId.size() <= 128
        && data.brandName is string && data.brandName.size() > 0 && data.brandName.size() <= 200
        && data.projectName is string && data.projectName.size() > 0 && data.projectName.size() <= 200;
    }

    // Influencers Collection Match Block
    match /influencers/{influencerId} {
      // Allow list and get operations for all visitors/testers
      allow read: if true;
      
      // Allow create and update provided the document structure matches constraints
      allow create: if isValidId(influencerId) 
        && isValidInfluencer(request.resource.data);
        
      allow update: if isValidId(influencerId) 
        && isValidInfluencer(request.resource.data);
        
      // Allow deletion
      allow delete: if true;

      // Subcollection for Cooperation/Campaign records
      match /records/{recordId} {
        allow read: if true;
        
        allow create: if isValidId(recordId) 
          && isValidRecord(request.resource.data);
          
        allow update: if isValidId(recordId) 
          && isValidRecord(request.resource.data);
          
        allow delete: if true;
      }
    }

    // Helper match block for admins list
    match /admins/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // Custom Users Collection for the self-built Auth System
    match /custom_users/{email} {
      allow read, write: if true;
    }

    // Schema Validation for Custom Tag entity
    function isValidCustomTag(data) {
      return data.keys().hasAll(['type', 'value'])
        && data.type is string && data.type.size() > 0 && data.type.size() <= 100
        && data.value is string && data.value.size() > 0 && data.value.size() <= 100;
    }

    // Dynamic User-created persistent tags list
    match /custom_tags/{tagId} {
      allow read: if true;
      allow create, update: if isValidId(tagId) && isValidCustomTag(request.resource.data);
      allow delete: if true;
    }
  }
}
